# Copia questo file in `.env` (che non viene versionato) e compila i valori.

# URL del tuo proxy CORS (Cloudflare Worker in `workers/viaggiatreno-proxy.js`).
# Se lo lasci vuoto l'app prova solo i proxy pubblici di fallback, che oggi
# sono inaffidabili: configurarlo e' la cosa piu' importante per far funzionare il monitor.
VITE_PROXY_URL=

# Codice stazione Viaggiatreno (default: Seveso).
VITE_STATION_CODE=S01925
